# ==========================================
# LLM Provider 配置（至少配置一种）
# 优先级: CODEBUDDY > MINIMAX > OPENAI
# ==========================================

# ------ 选项 1: CodeBuddy SDK ------
# CODEBUDDY_API_KEY=your_codebuddy_api_key
# CODEBUDDY_AUTH_TOKEN=your_auth_token

# ------ 选项 2: MiniMax API（推荐）------
# 获取 Key: https://platform.minimax.com
MINIMAX_API_KEY=your_minimax_api_key
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_MODEL=MiniMax-M1

# ------ 选项 3: 任意 OpenAI 兼容 API ------
# 支持 DeepSeek、Qwen、SiliconFlow、Groq 等
# OPENAI_API_KEY=your_api_key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ==========================================
# 服务器配置
# ==========================================
# PORT=3000
